-- 自动生成，业务项下的UI元数据
CREATE TABLE RelBizUIMeta (
	id             INTEGER  NOT NULL ,
	bId            INTEGER  NOT NULL REFERENCES Business(id),
	metaId         INTEGER  REFERENCES UIMeta(metaId),
	weight         INTEGER  NOT NULL DEFAULT 0, -- 显示排序权重
	tag            TEXT     NOT NULL DEFAULT "", -- 分组标签
	tagWeight      INTEGER  NOT NULL DEFAULT 0, -- 显示排序权重
	created        INTEGER  NOT NULL DEFAULT (strftime('%s', 'now')),
	PRIMARY KEY (bId,metaId)
);

selectBizAndUIMetaRelList:
SELECT id, bId,label,rb.metaId metaId,weight,tag,tagWeight
FROM RelBizUIMeta rb
LEFT JOIN UIMeta u ON u.metaId = rb.metaId
WHERE bId = ?;

insert:
INSERT INTO RelBizUIMeta(id,bId,metaId,weight,tag,tagWeight)
VALUES (?,?,?,?,?,?);

update:
UPDATE RelBizUIMeta
SET weight = ?, tag = ?,tagWeight = ?
WHERE id = ?;

deleteById:
DELETE FROM RelBizUIMeta
WHERE id = ?;