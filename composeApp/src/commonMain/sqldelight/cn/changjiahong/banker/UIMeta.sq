-- UI元数据
CREATE TABLE UIMeta (
 metaId          INTEGER  PRIMARY KEY NOT NULL ,
 label           TEXT     NOT NULL ,
 metaType        TEXT     NOT NULL ,
 width           INTEGER  NOT NULL DEFAULT 1,
 options         TEXT     , -- 选项列表，用于CheckBox/Radio/Table等
 validation      TEXT     NOT NULL DEFAULT "",
 forced          INTEGER  NOT NULL DEFAULT 0, --是否必输项
 isGlobal        INTEGER NOT NULL DEFAULT 0, -- 0=业务特定，1=全局共享
 created         INTEGER  NOT NULL DEFAULT (strftime('%s', 'now'))
);

selectAll:
SELECT *
FROM UIMeta;

insert:
INSERT INTO UIMeta(metaId,label,metaType,width,options,validation,forced,isGlobal)
VALUES (?,?,?,?,?,?,?,?);

update:
UPDATE UIMeta
SET (label,metaType,width,options,validation,forced,isGlobal) = (?,?,?,?,?,?,?)
WHERE metaId = ?;

delete:
DELETE FROM UIMeta
WHERE metaId = ?;