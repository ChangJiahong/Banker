-- 业务和模板的关系
CREATE TABLE RelBizTpl (
	id       INTEGER NOT NULL ,
	bId      INTEGER NOT NULL REFERENCES Business(id),
	tId      INTEGER NOT NULL REFERENCES Template(id),
	tag      TEXT    NOT NULL DEFAULT "", -- 分组标签
	created  INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
	PRIMARY KEY (bId,tId)
);

selectByBusinessAndTemplate:
SELECT *
FROM RelBizTpl
WHERE bId=? AND tId=?;

deleteTemplateFromBusiness:
DELETE FROM RelBizTpl
WHERE bId = ? AND tId = ?;

insert:
INSERT INTO RelBizTpl(id,bId,tId)
VALUES (?,?,?);