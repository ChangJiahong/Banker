-- 模板的字段，默认绑定的UI元数据
CREATE TABLE TplField (
	fieldId       INTEGER PRIMARY KEY NOT NULL ,
	templateId    INTEGER NOT NULL,
	formFieldName TEXT    NOT NULL,
	formFieldType TEXT    NOT NULL DEFAULT "TEXT",
	metaId        INTEGER REFERENCES UIMeta(metaId),
	isFixed       INTEGER NOT NULL DEFAULT 0 CHECK(isFixed IN (0,1)),
	fixedValue    TEXT    NOT NULL DEFAULT "",
	created       INTEGER NOT NULL DEFAULT (strftime('%s', 'now'))
);



selectTemplateFieldsById:
SELECT *
FROM TplField
WHERE templateId = ?;

insert:
INSERT INTO TplField(fieldId,templateId,formFieldName,formFieldType,metaId,isFixed,fixedValue)
VALUES (?,?,?,?,?,?,?);

update:
UPDATE TplField SET formFieldName=?,formFieldType=?,metaId=?,isFixed=?,fixedValue=?
WHERE fieldId=?;

delete:
DELETE FROM TplField
WHERE fieldId=?;

