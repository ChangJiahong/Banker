-- 元数据值
CREATE TABLE MetaValue (
	metaValueId   INTEGER,
	uid           INTEGER NOT NULL REFERENCES User(id),
	metaId        INTEGER NOT NULL REFERENCES UIMeta(metaId),
	bId           INTEGER REFERENCES Business(id), -- NULL 表示全局共享
	metaValue     TEXT NOT NULL,
	created       INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
	PRIMARY KEY (uid,metaId,bId)
);
